<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.app.mapper.FlowerCategoryMapper">

    <resultMap type="FlowerCategory" id="FlowerCategoryResult">
        <result property="id" column="id"/>
        <result property="categoryName" column="category_name"/>
        <result property="categoryDesc" column="category_desc"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectFlowerCategoryVo">
        select id, category_name, category_desc, sort_order, status, create_by, create_time, update_by, update_time, remark from flower_category
    </sql>

    <select id="selectFlowerCategoryList" parameterType="FlowerCategory" resultMap="FlowerCategoryResult">
        <include refid="selectFlowerCategoryVo"/>
        <where>
            <if test="categoryName != null  and categoryName != ''"> and category_name like concat('%', #{categoryName}, '%')</if>
            <if test="categoryDesc != null  and categoryDesc != ''"> and category_desc = #{categoryDesc}</if>
            <if test="sortOrder != null "> and sort_order = #{sortOrder}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
        order by sort_order
    </select>

    <select id="selectFlowerCategoryById" parameterType="Long" resultMap="FlowerCategoryResult">
        <include refid="selectFlowerCategoryVo"/>
        where id = #{id}
    </select>

    <insert id="insertFlowerCategory" parameterType="FlowerCategory" useGeneratedKeys="true" keyProperty="id">
        insert into flower_category
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="categoryName != null and categoryName != ''">category_name,</if>
            <if test="categoryDesc != null">category_desc,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="categoryName != null and categoryName != ''">#{categoryName},</if>
            <if test="categoryDesc != null">#{categoryDesc},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
         </trim>
    </insert>

    <update id="updateFlowerCategory" parameterType="FlowerCategory">
        update flower_category
        <trim prefix="SET" suffixOverrides=",">
            <if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
            <if test="categoryDesc != null">category_desc = #{categoryDesc},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFlowerCategoryById" parameterType="Long">
        delete from flower_category where id = #{id}
    </delete>

    <delete id="deleteFlowerCategoryByIds" parameterType="Long">
        delete from flower_category where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 检查分类下是否有关联的鲜花 -->
    <select id="countFlowersByCategoryId" parameterType="Long" resultType="int">
        select count(1) from flower_info where category_id = #{categoryId}
    </select>

</mapper>