<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.app.mapper.FlowerCustomerMapper">

    <resultMap type="FlowerCustomer" id="FlowerCustomerResult">
        <result property="id" column="id"/>
        <result property="customerName" column="customer_name"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="address" column="address"/>
        <result property="birthday" column="birthday"/>
        <result property="gender" column="gender"/>
        <result property="preference" column="preference"/>
        <result property="level" column="level"/>
        <result property="points" column="points"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectFlowerCustomerVo">
        select id, customer_name, phone, email, address, birthday, gender, preference, level, points, status, create_by, create_time, update_by, update_time, remark from flower_customer
    </sql>

    <select id="selectFlowerCustomerList" parameterType="FlowerCustomer" resultMap="FlowerCustomerResult">
        <include refid="selectFlowerCustomerVo"/>
        <where>
            <if test="customerName != null  and customerName != ''"> and customer_name like concat('%', #{customerName}, '%')</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="email != null  and email != ''"> and email = #{email}</if>
            <if test="address != null  and address != ''"> and address = #{address}</if>
            <if test="birthday != null "> and birthday = #{birthday}</if>
            <if test="gender != null "> and gender = #{gender}</if>
            <if test="preference != null  and preference != ''"> and preference = #{preference}</if>
            <if test="level != null "> and level = #{level}</if>
            <if test="points != null "> and points = #{points}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
        order by id
    </select>

    <select id="selectFlowerCustomerById" parameterType="Long" resultMap="FlowerCustomerResult">
        <include refid="selectFlowerCustomerVo"/>
        where id = #{id}
    </select>

    <insert id="insertFlowerCustomer" parameterType="FlowerCustomer" useGeneratedKeys="true" keyProperty="id">
        insert into flower_customer
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="customerName != null and customerName != ''">customer_name,</if>
            <if test="phone != null">phone,</if>
            <if test="email != null">email,</if>
            <if test="address != null">address,</if>
            <if test="birthday != null">birthday,</if>
            <if test="gender != null">gender,</if>
            <if test="preference != null">preference,</if>
            <if test="level != null">level,</if>
            <if test="points != null">points,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="customerName != null and customerName != ''">#{customerName},</if>
            <if test="phone != null">#{phone},</if>
            <if test="email != null">#{email},</if>
            <if test="address != null">#{address},</if>
            <if test="birthday != null">#{birthday},</if>
            <if test="gender != null">#{gender},</if>
            <if test="preference != null">#{preference},</if>
            <if test="level != null">#{level},</if>
            <if test="points != null">#{points},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
         </trim>
    </insert>

    <update id="updateFlowerCustomer" parameterType="FlowerCustomer">
        update flower_customer
        <trim prefix="SET" suffixOverrides=",">
            <if test="customerName != null and customerName != ''">customer_name = #{customerName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="address != null">address = #{address},</if>
            <if test="birthday != null">birthday = #{birthday},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="preference != null">preference = #{preference},</if>
            <if test="level != null">level = #{level},</if>
            <if test="points != null">points = #{points},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFlowerCustomerById" parameterType="Long">
        delete from flower_customer where id = #{id}
    </delete>

    <delete id="deleteFlowerCustomerByIds" parameterType="Long">
        delete from flower_customer where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>